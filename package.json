{
  "name": "comparator",
  "version": "0.3.0",
  "private": true,
  "description": "An implementation-independent Minecraft Java Edition conformance test suite",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "cts": "tsx src/cli.ts",
    "cts:list": "tsx src/cli.ts --list",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test e2e/*.test.ts",
    "test:vanilla": "tsx scripts/vanilla.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "minecraft-data": "3.117.0",
    "minecraft-protocol": "1.68.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
